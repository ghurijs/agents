{
  "name": "@ghuri/agents",
  "version": "0.1.0-alpha.1",
  "description": "Ghuri agents: AI agents with tools generated from models and viewsets, plus MCP",
  "type": "module",
  "license": "MIT",
  "author": "Ghuri contributors",
  "homepage": "https://github.com/ghurijs/agents#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghurijs/agents.git"
  },
  "bugs": {
    "url": "https://github.com/ghurijs/agents/issues"
  },
  "keywords": [
    "ghuri",
    "django",
    "cloudflare",
    "workers",
    "hono",
    "drizzle",
    "d1",
    "r2",
    "framework"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
